{
  "openapi": "3.0.3",
  "info": {
    "title": "Buildto V2 API — Foundation",
    "version": "0.3.0",
    "description": "Clerk-verified identity introspection and DB-authorized supplier/admin access. No mutation business APIs."
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getV21Liveness",
        "summary": "Process liveness",
        "responses": {
          "200": {
            "description": "Process available",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "operationId": "getV21Readiness",
        "summary": "Database connectivity; full V2.1 schema checked at boot",
        "responses": {
          "200": {
            "description": "Database ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ready"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/system": {
      "get": {
        "operationId": "getV21System",
        "summary": "Public API metadata; no business endpoints enabled",
        "responses": {
          "200": {
            "description": "API version and supported capabilities",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Rate limiter unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/me": {
      "get": {
        "operationId": "getMyIdentity",
        "summary": "Return current database-authoritative user and active memberships",
        "security": [
          {
            "clerkBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Own profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "User unprovisioned or inactive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/admin/access": {
      "get": {
        "operationId": "getAdminAccess",
        "summary": "Inspect own active administrator role",
        "security": [
          {
            "clerkBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or revoked session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient privilege",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/suppliers/{supplierId}/access": {
      "get": {
        "operationId": "getSupplierAccess",
        "summary": "Inspect membership on one exact supplier",
        "security": [
          {
            "clerkBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or revoked session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient privilege",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "supplierId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v2/webhooks/clerk": {
      "post": {
        "operationId": "clerkSignedWebhook",
        "summary": "Verify and synchronize signed Clerk identity events",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed event processed or idempotent duplicate"
          },
          "202": {
            "description": "Signed but unsupported event acknowledged"
          },
          "400": {
            "description": "Invalid payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Signature or timestamp invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Internal dependency unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "status",
          "service",
          "requestId"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "service": {
            "type": "string",
            "enum": [
              "buildto-v21-api"
            ]
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "Ready": {
        "type": "object",
        "required": [
          "ready",
          "requestId"
        ],
        "properties": {
          "ready": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "SystemEnvelope": {
        "type": "object",
        "required": [
          "data",
          "requestId"
        ],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "required": [
              "apiVersion",
              "currency",
              "moneyFormat",
              "releaseStage",
              "capabilities"
            ],
            "properties": {
              "apiVersion": {
                "type": "string",
                "enum": [
                  "v2"
                ]
              },
              "currency": {
                "type": "string",
                "enum": [
                  "INR"
                ]
              },
              "moneyFormat": {
                "type": "string",
                "enum": [
                  "decimal-string-paise"
                ]
              },
              "releaseStage": {
                "type": "string",
                "enum": [
                  "foundation"
                ]
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "error",
          "requestId"
        ],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "IdentityEnvelope": {
        "type": "object",
        "required": [
          "data",
          "requestId"
        ],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "description": "Minimum identity and role metadata; no token claims confer permissions."
          }
        }
      },
      "AccessEnvelope": {
        "type": "object",
        "required": [
          "data",
          "requestId"
        ],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "description": "Current database-authorized scope and role."
          }
        }
      }
    },
    "securitySchemes": {
      "clerkBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Clerk session JWT. Database membership decides privileges."
      }
    }
  }
}
