{
  "name": "kraveo-backend",
  "version": "1.0.0",
  "description": "Grozo multi-city grocery marketplace API and real-time server",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "db:deploy": "node scripts/migrate.mjs",
    "smoke:runtime": "node scripts/smoke.mjs",
    "start": "node dist/index.js",
    "start:render": "node scripts/migrate-hosted.mjs && node scripts/start-render.mjs",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest --runInBand",
    "seed:demo-partners": "node dist/utils/seedDemoPartners.js",
    "seed:pilot": "node scripts/seed-pilot.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "seed:construction": "node scripts/seed-construction.mjs",
    "db:contract:check": "node scripts/check-schema-contract.mjs runtime",
    "test:schema-contract": "node --test test/schemaContract.test.cjs",
    "db:v21:validate": "prisma validate --schema prisma/v21/schema.prisma",
    "db:v21:generate": "prisma generate --schema prisma/v21/schema.prisma",
    "db:v21:parity": "node scripts/v21/check-parity.mjs",
    "db:v21:verify": "node scripts/v21/manage-baseline.mjs verify",
    "db:v21:status": "node scripts/v21/manage-baseline.mjs status",
    "db:v21:baseline:resolve": "node scripts/v21/manage-baseline.mjs resolve-existing",
    "db:v21:deploy-empty": "node scripts/v21/manage-baseline.mjs deploy-empty",
    "test:v21:contract": "node --test test/v21SchemaContract.test.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.1106.0",
    "@clerk/express": "^2.1.81",
    "@prisma/client": "^5.14.0",
    "axios": "^1.6.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "^10.9.1",
    "jsonwebtoken": "^9.0.2",
    "prisma": "5.22.0",
    "razorpay": "^2.9.4",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
