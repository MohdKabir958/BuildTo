<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/white"/>
    <!-- Android masks the outer 18% of an adaptive icon. Inset keeps the wordmark inside the safe zone. -->
    <foreground>
        <inset
            android:drawable="@drawable/splyzo_launcher"
            android:inset="18%" />
    </foreground>
</adaptive-icon>
